---
/*
 * The ways to put a piece on a page, as tabs. Without script every way shows,
 * one after another, under its own heading.
 */
import { astroUsage, moduleUsage, reactUsage, readmeUsage, tagUsage, type Piece } from "../lib/library";
import { looping } from "../lib/svg";

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
// A logo comes in colour or in one ink, the page's text colour.
const logo = Boolean(piece.palette && !piece.ground);
const ways = [
  {
    name: "html",
    code: tagUsage(piece),
    note:
      "No install and no build step. ascii.js defines the <ascii-art> tag, loads the piece from ascii.rest, plays it while it is on screen, and holds the first frame for anyone who prefers reduced motion." +
      (logo ? ` Add mono, <ascii-art piece="${piece.slug}" mono>, for one ink.` : ""),
  },
  {
    name: "react",
    code: reactUsage(piece),
    note:
      `A client component, so it works in the Next.js app router as it is. Pass the name instead, piece="${piece.slug}", to fetch the piece only when it mounts.` +
      (logo ? " Add mono for one ink." : ""),
  },
  {
    name: "astro",
    code: astroUsage(piece),
    note: "Renders the first frame on the server, so the page is whole before any script runs, then plays the piece once it loads." + (logo ? " Add mono for one ink." : ""),
  },
  {
    name: "typescript",
    code: moduleUsage(piece),
    note:
      "mount plays a piece in a <pre>, or on a <canvas> for the coloured ones, and returns a function that stops it. Every piece, option and frame is typed." +
      (logo ? " Mount it in a <pre> for one ink." : ""),
  },
  ...(looping(piece.category, piece.options)
    ? [
        {
          name: "readme",
          code: readmeUsage(piece),
          note: "An animated SVG that needs no script, so it plays in a GitHub README, which runs none. GitHub shows the dark one in its dark theme. It holds still for anyone who prefers reduced motion.",
        },
      ]
    : []),
];
const id = `use-${piece.slug}`;
// Under the readme snippet, what it puts in a README: both SVGs at its width, on GitHub's light and dark grounds.
const grounds = [
  { theme: "light", file: `${piece.slug}.svg` },
  { theme: "dark", file: `${piece.slug}.dark.svg` },
];
---

<div class="usage" data-tabs>
  <div class="tabs" role="tablist" aria-label="Ways to use it" hidden>
    {ways.map((way, i) => (
      <button class="button" type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`}>
        <span>{way.name}</span>
      </button>
    ))}
  </div>
  {ways.map((way, i) => (
    <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`}>
      <div class="head">
        <h3 class="way">{way.name}</h3>
        <span class="tools">
          <button class="button" type="button" data-copy={`${id}-code-${i}`} hidden><span>[copy]</span></button>
        </span>
      </div>
      <pre class="code" id={`${id}-code-${i}`}>{way.code}</pre>
      {way.name === "readme" && (
        <div class="previews">
          {grounds.map((g) => (
            <figure class:list={["preview", g.theme]}>
              <div class="sheet">
                <img
                  src={`/svg/${g.file}`}
                  alt={`${piece.name}, as a ${g.theme} README shows it`}
                  width={piece.cols * 5}
                  height={piece.rows * 10}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption>{g.theme}, {g.file}</figcaption>
            </figure>
          ))}
        </div>
      )}
      <p class="muted note">{way.note}</p>
    </div>
  ))}
</div>
