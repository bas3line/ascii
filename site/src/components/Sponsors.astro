---
/*
 * The sponsors: a row of logo slots in wells, the sponsors first and open
 * slots after them. A sponsor is shown by its own official logo, the version
 * for the page's theme; logos only, its name the link's label for a screen
 * reader. On the author page, whose own line leads into it, open slots and
 * then the ways to sponsor; on the home page, under its first scene, a line of
 * thanks above and one open slot, asking for the next sponsor.
 */
import Icon from "./Icon.astro";
import { AUTHOR, SPONSORS, SUPPORT } from "../lib/library";

interface Props {
  /** For the home page: the line of thanks, one open slot, and no ways to pay. */
  home?: boolean;
}

const { home = false } = Astro.props;
const sponsor = `https://github.com/sponsors/${AUTHOR.handle}`;
const others = SUPPORT.filter((link) => link.href !== sponsor);
const open = home ? 1 : Math.max(1, 4 - SPONSORS.length);
---

<section id="sponsors" class:list={["sponsors", home && "home"]} aria-label="sponsors">
  {home && <p class="thanks">Thanks to the sponsors who make running ascii.rest possible.</p>}
  <ul class="slots" role="list">
    {SPONSORS.map((s) => (
      <li>
        <a class="slot logo" href={s.href} aria-label={s.name}>
          <span class="mark" style={`--h: ${s.height}rem`}>
            <img class="for-paper" src={`/sponsors/${s.logo}.svg`} alt="" />
            <img class="for-ink" src={`/sponsors/${s.logo}.dark.svg`} alt="" />
          </span>
        </a>
      </li>
    ))}
    {Array.from({ length: open }, () => (
      <li>
        {home ? (
          <a class="slot open" href={sponsor}><span class="label">become a sponsor</span></a>
        ) : (
          <a class="slot open" href={sponsor} aria-label="Sponsor ascii.rest on GitHub and your logo goes here">
            <span class="label">your logo</span>
          </a>
        )}
      </li>
    ))}
  </ul>
  {!home && (
    <p class="ways">
      <a href={sponsor}>[sponsor on github]</a>
      {others.map((link) => (
        <a class="quiet" href={link.href}><Icon name={link.icon} /><span>{link.label}</span></a>
      ))}
    </p>
  )}
</section>

<style>
  .sponsors {
    margin-top: 2rem;
  }

  .home {
    margin-top: 1.5rem;
  }

  .thanks {
    margin: 0 0 0.75rem;
    color: var(--muted);
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3ch;
  }

  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 7rem;
    padding: 0.6rem 1ch;
    margin: 0;
    background: var(--well);
    color: var(--ink);
    text-align: center;
  }

  .slot.open {
    color: var(--muted);
  }

  /* The logo, centred in its well at its own height, never wider than most of it. */
  .mark {
    display: grid;
    place-items: center;
    width: 100%;
    flex: 1;
    min-height: 0;
  }

  .mark img {
    grid-area: 1 / 1;
    height: var(--h);
    max-width: 82%;
    object-fit: contain;
  }

  /* The version for the page: the dark one on a dark page, as the site starts, the light one on a light page. */
  .for-paper {
    display: none;
  }

  :global(:root[data-theme="light"]) .for-paper {
    display: block;
  }

  :global(:root[data-theme="light"]) .for-ink {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .for-paper {
      display: block;
    }

    :global(:root:not([data-theme="dark"])) .for-ink {
      display: none;
    }
  }

  .label {
    padding: 0 var(--pad);
    margin: 0 calc(var(--pad) * -1);
  }

  /* Like a card: the well stays, the name inverts. */
  @media (hover: hover) {
    .slot:hover {
      background: var(--well);
      color: var(--ink);
    }

    .slot.open:hover {
      color: var(--muted);
    }

    .slot:hover .label {
      background: var(--ink);
      color: var(--bg);
    }
  }

  .slot:focus-visible {
    background: var(--well);
    color: var(--ink);
    outline: none;
  }

  .slot.open:focus-visible {
    color: var(--muted);
  }

  .slot:focus-visible .label {
    background: var(--ink);
    color: var(--bg);
    outline: 1px dotted var(--ink);
    outline-offset: 2px;
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 3ch;
    margin-top: 1rem;
  }

  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--muted);
  }

  @media (hover: hover) {
    .quiet:hover {
      color: var(--bg);
    }
  }

  .quiet:focus-visible {
    color: var(--bg);
  }

  /* Phones: two slots to a row. */
  @media (max-width: 640px) {
    .slots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .slot {
      height: 6rem;
    }
  }
</style>
