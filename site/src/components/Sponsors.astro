---
/*
 * The sponsors: a row of logo slots in wells, Cloudflare first and open slots
 * after it, then the ways to sponsor. The home page shows it after the scenes
 * with a heading and a line of copy; compact drops both, for the author page,
 * whose own line leads into it. A sponsor's logo is our own ascii piece of it,
 * playing in its slot like any card, with its name under it.
 */
import Art from "./Art.astro";
import Icon from "./Icon.astro";
import { AUTHOR, SUPPORT, pieces } from "../lib/library";

interface Props {
  /** Without the heading and the line of copy. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const sponsor = `https://github.com/sponsors/${AUTHOR.handle}`;
const others = SUPPORT.filter((link) => link.href !== sponsor);
const SPONSORS = [{ name: "Cloudflare", href: "https://www.cloudflare.com", slug: "cloudflare" }];
const logos = SPONSORS.map((s) => {
  const piece = pieces.find((p) => p.slug === s.slug);
  if (!piece) throw new Error(`Sponsors: there is no piece named "${s.slug}"`);
  return { ...s, piece };
});
const open = 4 - logos.length;
---

<section
  id="sponsors"
  class:list={["sponsors", compact && "compact"]}
  aria-labelledby={compact ? undefined : "sponsors-title"}
  aria-label={compact ? "sponsors" : undefined}
>
  {!compact && (
    <>
      <div class="head">
        <h2 id="sponsors-title">sponsors</h2>
      </div>
      <p class="line">ascii.rest is free and MIT licensed. Sponsor it and your logo goes here.</p>
    </>
  )}
  <ul class="slots" role="list">
    {logos.map((s) => (
      <li>
        <a class="slot logo" href={s.href} aria-label={s.name}>
          <span class="mark well"><Art piece={s.piece} /></span>
          <span class="label">{s.name}</span>
        </a>
      </li>
    ))}
    {Array.from({ length: open }, () => (
      <li>
        <a class="slot open" href={sponsor} aria-label="Sponsor ascii.rest on GitHub and your logo goes here">
          <span class="label">your logo</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="ways">
    <a href={sponsor}>[sponsor on github]</a>
    {others.map((link) => (
      <a class="quiet" href={link.href}><Icon name={link.icon} /><span>{link.label}</span></a>
    ))}
  </p>
</section>

<style>
  .compact {
    margin-top: 2rem;
  }

  .line {
    max-width: 72ch;
    margin-bottom: 1rem;
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3ch;
  }

  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 7rem;
    padding: 0.6rem 1ch;
    margin: 0;
    background: var(--well);
    color: var(--ink);
    text-align: center;
  }

  .slot.open {
    color: var(--muted);
  }

  /* The logo's own box: the site sizes a piece to the well it sits in. */
  .mark {
    width: 100%;
    flex: 1;
    min-height: 0;
    aspect-ratio: auto;
  }

  .label {
    padding: 0 var(--pad);
    margin: 0 calc(var(--pad) * -1);
  }

  .logo .label {
    font-size: 0.85em;
    color: var(--text);
  }

  /* Like a card: the well stays, the name inverts. */
  @media (hover: hover) {
    .slot:hover {
      background: var(--well);
      color: var(--ink);
    }

    .slot.open:hover {
      color: var(--muted);
    }

    .slot:hover .label {
      background: var(--ink);
      color: var(--bg);
    }
  }

  .slot:focus-visible {
    background: var(--well);
    color: var(--ink);
    outline: none;
  }

  .slot.open:focus-visible {
    color: var(--muted);
  }

  .slot:focus-visible .label {
    background: var(--ink);
    color: var(--bg);
    outline: 1px dotted var(--ink);
    outline-offset: 2px;
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 3ch;
    margin-top: 1rem;
  }

  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--muted);
  }

  @media (hover: hover) {
    .quiet:hover {
      color: var(--bg);
    }
  }

  .quiet:focus-visible {
    color: var(--bg);
  }

  /* Phones: two slots to a row. */
  @media (max-width: 640px) {
    .slots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .slot {
      height: 6rem;
    }
  }
</style>
