---
/*
 * The sponsors: a row of logo slots in wells, Cloudflare first and open slots
 * after it, then the ways to sponsor. The home page shows it after the scenes
 * with a heading and a line of copy; compact drops both, for the author page,
 * whose own line leads into it. The Cloudflare mark is the simple-icons 16.34.0
 * path (CC0), in the text colour.
 */
import Icon from "./Icon.astro";
import { AUTHOR, SUPPORT } from "../lib/library";

interface Props {
  /** Without the heading and the line of copy. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const sponsor = `https://github.com/sponsors/${AUTHOR.handle}`;
const others = SUPPORT.filter((link) => link.href !== sponsor);
const open = 3;
---

<section
  id="sponsors"
  class:list={["sponsors", compact && "compact"]}
  aria-labelledby={compact ? undefined : "sponsors-title"}
  aria-label={compact ? "sponsors" : undefined}
>
  {!compact && (
    <>
      <div class="head">
        <h2 id="sponsors-title">sponsors</h2>
      </div>
      <p class="line">ascii.rest is free and MIT licensed. Sponsor it and your logo goes here.</p>
    </>
  )}
  <ul class="slots" role="list">
    <li>
      <a class="slot" href="https://www.cloudflare.com">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M16.5088 16.8447c.1475-.5068.0908-.9707-.1553-1.3154-.2246-.3164-.6045-.499-1.0615-.5205l-8.6592-.1123a.1559.1559 0 0 1-.1333-.0713c-.0283-.042-.0351-.0986-.021-.1553.0278-.084.1123-.1484.2036-.1562l8.7359-.1123c1.0351-.0489 2.1601-.8868 2.5537-1.9136l.499-1.3013c.0215-.0561.0293-.1128.0147-.168-.5625-2.5463-2.835-4.4453-5.5499-4.4453-2.5039 0-4.6284 1.6177-5.3876 3.8614-.4927-.3658-1.1187-.5625-1.794-.499-1.2026.119-2.1665 1.083-2.2861 2.2856-.0283.31-.0069.6128.0635.894C1.5683 13.171 0 14.7754 0 16.752c0 .1748.0142.3515.0352.5273.0141.083.0844.1475.1689.1475h15.9814c.0909 0 .1758-.0645.2032-.1553l.12-.4268zm2.7568-5.5634c-.0771 0-.1611 0-.2383.0112-.0566 0-.1054.0415-.127.0976l-.3378 1.1744c-.1475.5068-.0918.9707.1543 1.3164.2256.3164.6055.498 1.0625.5195l1.8437.1133c.0557 0 .1055.0263.1329.0703.0283.043.0351.1074.0214.1562-.0283.084-.1132.1485-.204.1553l-1.921.1123c-1.041.0488-2.1582.8867-2.5527 1.914l-.1406.3585c-.0283.0713.0215.1416.0986.1416h6.5977c.0771 0 .1474-.0489.169-.126.1122-.4082.1757-.837.1757-1.2803 0-2.6025-2.125-4.727-4.7344-4.727"></path>
        </svg>
        <span>Cloudflare</span>
      </a>
    </li>
    {Array.from({ length: open }, () => (
      <li>
        <a class="slot open" href={sponsor} aria-label="Sponsor ascii.rest on GitHub and your logo goes here">
          <span>your logo</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="ways">
    <a href={sponsor}>[sponsor on github]</a>
    {others.map((link) => (
      <a class="quiet" href={link.href}><Icon name={link.icon} /><span>{link.label}</span></a>
    ))}
  </p>
</section>

<style>
  .compact {
    margin-top: 2rem;
  }

  .line {
    max-width: 72ch;
    margin-bottom: 1rem;
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3ch;
  }

  .slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: center;
    gap: 0.25rem 1ch;
    height: 4.5rem;
    padding: 0 1ch;
    margin: 0;
    background: var(--well);
    color: var(--ink);
    text-align: center;
  }

  .slot.open {
    color: var(--muted);
  }

  .slot svg {
    flex: none;
  }

  .slot span {
    padding: 0 var(--pad);
    margin: 0 calc(var(--pad) * -1);
  }

  /* Like a card: the well stays, the name inverts. */
  @media (hover: hover) {
    .slot:hover {
      background: var(--well);
      color: var(--ink);
    }

    .slot.open:hover {
      color: var(--muted);
    }

    .slot:hover span {
      background: var(--ink);
      color: var(--bg);
    }
  }

  .slot:focus-visible {
    background: var(--well);
    color: var(--ink);
    outline: none;
  }

  .slot.open:focus-visible {
    color: var(--muted);
  }

  .slot:focus-visible span {
    background: var(--ink);
    color: var(--bg);
    outline: 1px dotted var(--ink);
    outline-offset: 2px;
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 3ch;
    margin-top: 1rem;
  }

  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--muted);
  }

  @media (hover: hover) {
    .quiet:hover {
      color: var(--bg);
    }
  }

  .quiet:focus-visible {
    color: var(--bg);
  }

  /* Phones: two slots to a row. */
  @media (max-width: 640px) {
    .slots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .slot {
      height: 4rem;
    }
  }
</style>
