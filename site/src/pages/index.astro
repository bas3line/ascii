---
/*
 * ascii.rest: a scene playing, the sponsors, what the library is, how to use a
 * piece, and then every piece by category, each a live preview linking to its
 * own page.
 */
import Layout from "../layouts/Layout.astro";
import Art from "../components/Art.astro";
import Sponsors from "../components/Sponsors.astro";
import Usage from "../components/Usage.astro";
import { categories, issue, pieces } from "../lib/library";

const hero = pieces.find((p) => p.slug === "aurora-fjord") ?? pieces[0];
const example = pieces.find((p) => p.slug === "donut") ?? pieces[0];
const scenes = pieces.filter((p) => p.category === "scenes").length;
const logos = pieces.filter((p) => p.category === "logos").length;
const distros = pieces.filter((p) => p.category === "distros").length;
const companies = pieces.filter((p) => p.category === "companies").length;
// The categories whose grid ends in a card asking for the logo someone is missing.
const LOGOS = ["logos", "companies", "distros"];
const description = `${pieces.length} animated ascii pieces for web pages, in TypeScript with no dependencies: for React, Next.js, Astro, or one HTML tag. MIT licensed.`;
---

<Layout title="ascii.rest: animated ascii art for web pages, by @bas3line" description={description} path="/">
  <a slot="notice" class="notice" href="/docs/">
    <span class="tag">new</span>
    <span class="shine">introducing image to ascii, banners in code, an svg of any piece, a shadcn registry and docs for all of it</span>
    <span class="go">[take a look]</span>
  </a>
  <h1 slot="heading">animated ascii art for web pages</h1>

  <a class="hero" href={`/${hero.slug}/`} aria-label={`${hero.name}, one of the scenes`}>
    <div class:list={["well big", hero.palette && "scene"]} style={hero.ground && `--ground: ${hero.ground}`}>
      <Art piece={hero} />
    </div>
  </a>

  <Sponsors home />

  <p class="pitch">
    {pieces.length} animated ascii pieces for web pages: {scenes} full-colour scenes like the one above, loaders, charts, type,
    {logos} language logos, {companies} company logos and {distros} Linux distros in colour or one ink, and 3D shapes, physics and creatures. Each is a small, typed TypeScript module with no dependencies, for
    React, Next.js, Astro, or a plain HTML page, and free to use and change under the MIT license.
  </p>
  <p class="term">
    Or play any of them in your terminal: <code id="term-command">npx ascii.rest {example.slug}</code>
    <button class="button" type="button" data-copy="term-command" hidden><span>[copy]</span></button>
  </p>
  <p class="term">Or your name in block letters, for a README or a terminal: <a href="/banner/">[make a readme banner]</a></p>
  <p class="term">Or any image, a logo or a photo, as animated ascii: <a href="/make/">[image to ascii]</a></p>
  <p class="term">React, Next.js, Astro, one HTML tag, an SVG, or the source copied into your project: <a href="/docs/">[read the docs]</a></p>

  <section id="use" class="block">
    <div class="head">
      <h2>use one</h2>
      <span class="tools"><a href="/docs/">[docs]</a></span>
    </div>
    <Usage piece={example} />
  </section>

  <div id="pieces">
    {categories.map((category) => (
      <section id={category.name}>
        <div class="head">
          <h2>{category.name}</h2>
          <span class="count">{category.pieces.length}</span>
          {category.pieces.some((piece) => piece.palette && !piece.ground) && (
            <span class="tools">
              <a href={issue("logo")}>[request a logo]</a>
              <button class="button" type="button" data-ink hidden><span>[mono]</span></button>
            </span>
          )}
        </div>
        <div class:list={["grid", category.name === "scenes" && "wide"]}>
          {category.pieces.map((piece) => (
            <a class="card" href={`/${piece.slug}/`}>
              <div class:list={["well", piece.ground && "scene"]} style={piece.ground && `--ground: ${piece.ground}`}>
                <Art piece={piece} />
              </div>
              <span class="name">{piece.name}</span>
              {piece.recent && <span class="new">new</span>}
              <span class="note">{piece.note}</span>
            </a>
          ))}
          {LOGOS.includes(category.name) && (
            <a class="card ask" href={issue("logo")}>
              <div class="well"><span>[request a logo]</span></div>
              <span class="name">missing one?</span>
              <span class="note">ask for a company, language or distro you'd like drawn like these</span>
            </a>
          )}
        </div>
      </section>
    ))}
  </div>
</Layout>
