---
/*
 * ascii.rest: hero scene preview, clean category switcher,
 * and modular collection grids by parent category.
 */
import Layout from "../layouts/Layout.astro";
import Art from "../components/Art.astro";
import { categories, groups, pieces } from "../lib/library";

const hero = pieces.find((p) => p.slug === "aurora-fjord") ?? pieces[0];
const description = `${pieces.length} animated ascii pieces for web pages. MIT licensed.`;
---

<Layout title="ascii.rest: animated ascii art" description={description} path="/" home>
  <a slot="notice" class="notice" href="/#scenes">
    <span class="tag">new</span>
    <span class="shine">19 new scenes: saturn rise, amer fort, lake pichola, snow train, black prism and more</span>
    <span class="go">[view scenes]</span>
  </a>

  <!-- Top Hero Scene -->
  <script is:inline>document.documentElement.classList.add("pick-hero");</script>
  <a class="hero" href={`/${hero.slug}/`} aria-label={`${hero.name}, one of the scenes`}>
    <div class:list={["well big", hero.palette && "scene"]} style={hero.ground && `--ground: ${hero.ground}`}>
      <Art piece={hero} />
    </div>
  </a>

  <!-- Category Filter Bar: Modular collection breakdown -->
  <section class="collection-section">
    <nav class="cat-pill-bar" id="cat-pill-bar" aria-label="Filter collection by category">
      {categories.map((c, i) => (
        <button
          class:list={["cat-pill", i === 0 && "active"]}
          type="button"
          data-cat={c.name}
        >
          [{c.name}] <span class="pill-count">{c.pieces.length}</span>
        </button>
      ))}
    </nav>

    <!-- Individual Category Grids (One active at a time, or jump to by hash) -->
    <div id="pieces-container">
      {categories.map((category, i) => (
        <section
          id={category.name}
          class:list={["category-view", i === 0 && "active"]}
          data-category={category.name}
        >
          <div class="head">
            <h2>{category.name}</h2>
            <span class="count">{category.pieces.length} pieces</span>
          </div>

          <div class:list={["grid", category.name === "scenes" && "wide"]}>
            {category.pieces.map((piece) => (
              <a class="card" href={`/${piece.slug}/`}>
                <div class:list={["well", piece.ground && "scene"]} style={piece.ground && `--ground: ${piece.ground}`}>
                  <Art piece={piece} />
                </div>
                <span class="name">{piece.name}</span>
                {piece.recent && <span class="new">new</span>}
                <span class="note">{piece.note}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <style>
    .collection-section {
      margin-top: 2rem;
    }

    .cat-pill-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--well);
    }

    .cat-pill {
      background: transparent;
      border: 1px solid var(--well);
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.8rem;
      padding: 0.25rem 0.55rem;
      cursor: pointer;
      border-radius: 0;
      transition: color 0.1s, border-color 0.1s, background 0.1s;
    }

    .cat-pill:hover {
      color: var(--ink);
      border-color: var(--ink);
    }

    .cat-pill.active {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    .cat-pill.active .pill-count {
      color: var(--bg);
      opacity: 0.8;
    }

    .pill-count {
      font-size: 0.75em;
      color: var(--muted);
      margin-left: 0.2ch;
    }

    .category-view {
      display: none;
    }

    .category-view.active {
      display: block;
    }
  </style>

  <script is:inline>
    // Tab switching for category breakdown & hash routing
    (function () {
      var pills = document.querySelectorAll(".cat-pill");
      var views = document.querySelectorAll(".category-view");

      function showCategory(catName) {
        pills.forEach(function (p) {
          p.classList.toggle("active", p.getAttribute("data-cat") === catName);
        });
        views.forEach(function (v) {
          v.classList.toggle("active", v.getAttribute("data-category") === catName);
        });
      }

      pills.forEach(function (pill) {
        pill.addEventListener("click", function () {
          var cat = pill.getAttribute("data-cat");
          if (cat) {
            showCategory(cat);
            history.replaceState(null, "", "#" + cat);
          }
        });
      });

      function handleHash() {
        var hash = location.hash.replace(/^#/, "");
        if (hash) {
          var match = Array.from(views).some(function (v) {
            return v.getAttribute("data-category") === hash;
          });
          if (match) showCategory(hash);
        }
      }

      window.addEventListener("hashchange", handleHash);
      handleHash();
    })();
  </script>

  <!-- Hero randomizer -->
  <script is:inline>
    (function () {
      var hero = document.querySelector(".hero");
      var cards = document.querySelectorAll("#scenes pre[data-piece]");
      try {
        if (hero && cards.length) {
          var from = cards[Math.floor(Math.random() * cards.length)];
          var pre = hero.querySelector("pre.art");
          var well = hero.querySelector(".well");
          var name = from.getAttribute("aria-label");
          var ground = from.closest(".well").style.getPropertyValue("--ground");
          pre.innerHTML = from.innerHTML;
          pre.dataset.piece = from.dataset.piece;
          pre.setAttribute("style", from.getAttribute("style"));
          pre.setAttribute("aria-label", name);
          if (ground) well.style.setProperty("--ground", ground);
          hero.href = "/" + from.dataset.piece + "/";
          hero.setAttribute("aria-label", name + ", one of the scenes");
        }
      } finally {
        document.documentElement.classList.remove("pick-hero");
      }
    })();
  </script>
</Layout>
