---
/*
 * ascii.rest: hero scene preview, clean parent category switcher
 * broken up according to the sidebar parents (scenes, components, brands, more).
 */
import Layout from "../layouts/Layout.astro";
import Art from "../components/Art.astro";
import { groups, pieces } from "../lib/library";

const hero = pieces.find((p) => p.slug === "aurora-fjord") ?? pieces[0];
const description = `${pieces.length} animated ascii pieces for web pages. MIT licensed.`;
---

<Layout title="ascii.rest: animated ascii art" description={description} path="/" home>
  <!-- Top Hero Scene -->
  <script is:inline>document.documentElement.classList.add("pick-hero");</script>
  <a class="hero" href={`/${hero.slug}/`} aria-label={`${hero.name}, one of the scenes`}>
    <div class:list={["well big", hero.palette && "scene"]} style={hero.ground && `--ground: ${hero.ground}`}>
      <Art piece={hero} />
    </div>
  </a>

  <!-- Parent Group Switcher -->
  <section class="collection-section">
    <nav class="group-tab-bar" id="group-tab-bar" aria-label="Collection parent sections">
      {groups.map((group, i) => {
        const total = group.categories.reduce((acc, c) => acc + c.pieces.length, 0);
        return (
          <button
            class:list={["group-tab", i === 0 && "active"]}
            type="button"
            data-group={group.label}
          >
            <span class="tab-icon">{group.icon}</span>
            <span class="tab-label">{group.label}</span>
            <span class="tab-count">{total}</span>
          </button>
        );
      })}
    </nav>

    <!-- Parent Views: one displayed at a time -->
    <div id="parent-groups-container">
      {groups.map((group, i) => {
        const isScenes = group.label === "scenes";
        return (
          <div
            id={`group-${group.label}`}
            class:list={["group-view", i === 0 && "active"]}
            data-group-view={group.label}
          >
            {isScenes ? (
              <div class="grid wide">
                {group.categories[0].pieces.map((piece) => (
                  <a class="card" href={`/${piece.slug}/`}>
                    <div class:list={["well", piece.ground && "scene"]} style={piece.ground && `--ground: ${piece.ground}`}>
                      <Art piece={piece} />
                    </div>
                    <span class="name">{piece.name}</span>
                    {piece.recent && <span class="new">new</span>}
                    <span class="note">{piece.note}</span>
                  </a>
                ))}
              </div>
            ) : (
              <div class="sub-categories-stack">
                {group.categories.map((category) => (
                  <section class="category-block" id={category.name}>
                    <div class="head">
                      <h2>{category.name}</h2>
                      <span class="count">{category.pieces.length} pieces</span>
                    </div>
                    <div class="grid">
                      {category.pieces.map((piece) => (
                        <a class="card" href={`/${piece.slug}/`}>
                          <div class:list={["well", piece.ground && "scene"]} style={piece.ground && `--ground: ${piece.ground}`}>
                            <Art piece={piece} />
                          </div>
                          <span class="name">{piece.name}</span>
                          {piece.recent && <span class="new">new</span>}
                          <span class="note">{piece.note}</span>
                        </a>
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <style>
    .collection-section {
      margin-top: 1.5rem;
    }

    .group-tab-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.75rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--well);
    }

    .group-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.5ch;
      background: transparent;
      border: 1px solid var(--well);
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.85rem;
      padding: 0.35rem 0.75rem;
      cursor: pointer;
      border-radius: 0;
      transition: color 0.1s, border-color 0.1s, background 0.1s;
    }

    .group-tab:hover {
      color: var(--ink);
      border-color: var(--ink);
    }

    .group-tab.active {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    .tab-icon {
      font-size: 0.95em;
    }

    .tab-count {
      font-size: 0.75em;
      opacity: 0.8;
      margin-left: 0.2ch;
    }

    .group-view {
      display: none;
    }

    .group-view.active {
      display: block;
    }

    .sub-categories-stack {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .category-block .head {
      margin-bottom: 0.75rem;
    }
  </style>

  <script is:inline>
    // Tab switching for parent group breakdown & hash routing
    (function () {
      var tabs = document.querySelectorAll(".group-tab");
      var views = document.querySelectorAll(".group-view");

      function showGroup(groupName) {
        tabs.forEach(function (t) {
          t.classList.toggle("active", t.getAttribute("data-group") === groupName);
        });
        views.forEach(function (v) {
          v.classList.toggle("active", v.getAttribute("data-group-view") === groupName);
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          var grp = tab.getAttribute("data-group");
          if (grp) {
            showGroup(grp);
            history.replaceState(null, "", "#" + grp);
          }
        });
      });

      function handleHash() {
        var hash = location.hash.replace(/^#/, "");
        if (!hash) return;

        // Check if hash matches a parent group
        var directMatch = Array.from(views).some(function (v) {
          return v.getAttribute("data-group-view") === hash;
        });
        if (directMatch) {
          showGroup(hash);
          return;
        }

        // Check if hash matches a sub-category inside one of the parent groups
        var subEl = document.getElementById(hash);
        if (subEl) {
          var parentView = subEl.closest(".group-view");
          if (parentView) {
            var grp = parentView.getAttribute("data-group-view");
            if (grp) {
              showGroup(grp);
              subEl.scrollIntoView({ behavior: "smooth" });
            }
          }
        }
      }

      window.addEventListener("hashchange", handleHash);
      handleHash();
    })();
  </script>

  <!-- Hero randomizer -->
  <script is:inline>
    (function () {
      var hero = document.querySelector(".hero");
      var cards = document.querySelectorAll("#group-scenes pre[data-piece]");
      try {
        if (hero && cards.length) {
          var from = cards[Math.floor(Math.random() * cards.length)];
          var pre = hero.querySelector("pre.art");
          var well = hero.querySelector(".well");
          var name = from.getAttribute("aria-label");
          var ground = from.closest(".well").style.getPropertyValue("--ground");
          pre.innerHTML = from.innerHTML;
          pre.dataset.piece = from.dataset.piece;
          pre.setAttribute("style", from.getAttribute("style"));
          pre.setAttribute("aria-label", name);
          if (ground) well.style.setProperty("--ground", ground);
          hero.href = "/" + from.dataset.piece + "/";
          hero.setAttribute("aria-label", name + ", one of the scenes");
        }
      } finally {
        document.documentElement.classList.remove("pick-hero");
      }
    })();
  </script>
</Layout>
