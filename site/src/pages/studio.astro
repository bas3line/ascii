  .param-color-right input[type="color"]::-moz-color-swatch {
    border: none;
    border-radius: 0;
  }

  /* Custom Checkbox */
  input[type="checkbox"].layer-chk {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
