    border: 1px solid var(--muted);
    border-radius: 0;
    cursor: pointer;
    display: inline-grid;
    place-content: center;
    margin: 0;
    vertical-align: middle;
  }

  input[type="checkbox"].layer-chk:checked {
    background: var(--ink);
    border-color: var(--ink);
  }

  input[type="checkbox"].layer-chk:checked::before {
    content: "✓";
    font-size: 11px;
    color: var(--bg);
    line-height: 1;
    font-weight: 700;
  }

  .palette-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 0.5rem 0;
  }

  .palette-note {
    margin: 0.2rem 0 0;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .hidden {
    display: none !important;
  }

  .color-swatch {
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-sizing: border-box;
  }

  /* Image Dropzone */
  .dropzone {
    border: 1px dashed var(--muted);
    padding: 1.75rem 0.75rem;
    text-align: center;
    cursor: pointer;
    background: var(--well);
  }

  .dropzone:hover {
    border-color: var(--ink);
  }

  .drop-primary {
    font-size: 0.8rem;
    color: var(--ink);
    margin: 0 0 0.2rem;
  }

  .drop-muted {
    font-size: 0.7rem;
    color: var(--muted);
    margin: 0;
  }

  /* Code Strip Underneath */
  .code-strip {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border: 1px solid var(--well);
    background: var(--bg);
    padding: 0.6rem 0.75rem;
  }

  .code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .code-display {
    margin: 0;
    padding: 1rem;
    background: var(--well);
    border: 1px solid var(--well);
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text);
    white-space: pre;
    overflow-x: auto;
  }

  .studio-credit {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .studio-credit a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--well);
  }

  .studio-credit a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>

<script>
  import { load } from "ascii.rest";
  import type { Env, Frame, Meta, Options, Piece } from "ascii.rest";
  import type { SceneSpec, StudioSession } from "ascii.rest/studio";
  import {
    compileSceneToCode,
    createStudioSession,
    getLayerDefinition,
    hexToRgb,
  } from "ascii.rest/studio";

  // What the studio is showing: a library piece, or a scene-engine spec
  // (the image ingestion runs through the engine too).
  type Active =
    | {
        kind: "piece";
        slug: string;
        mod: Piece;
        frame: Frame;
        options: Record<string, unknown>;
        colorOverride: Record<number, string>;
      }
    | { kind: "scene"; session: StudioSession; name: string };

  let active: Active | null = null;
  let session: StudioSession | null = null;
  let selectedLayerId = "";
  let groundOverride: string | null = null;
  let loadToken = 0;

  // Playback state
  let isPlaying = true;
  let playbackSpeed = 1.0;
  let currentTime = 0;
  let lastTimestamp = performance.now();
  let animId: number | null = null;

  // DOM Elements
  const canvas = document.getElementById("studio-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d", { alpha: false });
  const canvasBox = document.getElementById("canvas-box") as HTMLElement;
  const playBtn = document.getElementById("btn-play") as HTMLButtonElement;
  const playIcon = document.getElementById("play-icon") as HTMLSpanElement;
  const scrubber = document.getElementById("timeline-scrubber") as HTMLInputElement;
  const timeDisplay = document.getElementById("time-display") as HTMLSpanElement;
  const perfDisplay = document.getElementById("stat-perf") as HTMLSpanElement;
  const speedPills = document.querySelectorAll(".speed-pill");
  const panelTabs = document.querySelectorAll(".panel-tab-btn");
  const panelBodies = document.querySelectorAll(".panel-body");
  const layerStackWrap = document.getElementById("layer-stack-wrap") as HTMLElement;
  const layerListEl = document.getElementById("layer-list") as HTMLElement;
  const paramsTitle = document.getElementById("params-title") as HTMLElement;
  const layerControlsEl = document.getElementById("layer-controls") as HTMLElement;
  const paletteSection = document.querySelector(".palette-swatches-section") as HTMLElement;
  const paletteGridEl = document.getElementById("palette-grid") as HTMLElement;
  const paletteCountEl = document.getElementById("palette-count") as HTMLElement;
  const paletteNote = document.getElementById("palette-note") as HTMLElement;
  const colGroundInput = document.getElementById("col-ground") as HTMLInputElement;
  const hexGroundLabel = document.getElementById("hex-ground") as HTMLSpanElement;
  const groundRow = document.getElementById("ground-row") as HTMLElement;
  const halftoneRows = document.getElementById("halftone-rows") as HTMLElement;
  const selRamp = document.getElementById("sel-ramp") as HTMLSelectElement;
  const selDither = document.getElementById("sel-dither") as HTMLSelectElement;
  const rangeContrast = document.getElementById("range-contrast") as HTMLInputElement;
  const valContrast = document.getElementById("val-contrast") as HTMLSpanElement;
  const codeLabel = document.getElementById("code-label") as HTMLElement;
  const codeOutput = document.getElementById("code-output") as HTMLElement;
  const btnExportCode = document.getElementById("btn-export-code") as HTMLButtonElement;
  const btnCopyCodeTab = document.getElementById("btn-copy-code-tab") as HTMLButtonElement;
  const imageDrop = document.getElementById("image-drop") as HTMLElement;
  const imageFileInput = document.getElementById("image-file-input") as HTMLInputElement;
  const ingestMotion = document.getElementById("ingest-motion") as HTMLSelectElement;
  const ingestSplit = document.getElementById("ingest-split") as HTMLInputElement;

  const pickerBtn = document.getElementById("picker-btn") as HTMLButtonElement;
  const pickerValue = document.getElementById("picker-value") as HTMLElement;
  const pickerPanel = document.getElementById("picker-panel") as HTMLElement;
  const pickerMenu = document.getElementById("picker-menu") as HTMLElement;
  const pickerSearch = document.getElementById("picker-search") as HTMLInputElement;

  // Cell colors, indexed the way frames write them: one palette index per cell.
  let colorIndices = new Uint8Array(0);
  const colorMap = new Map<number, [number, number, number]>();

  function activeMeta(): Meta {
    return active!.kind === "piece" ? active.mod.meta : active!.session.piece.meta;
  }

  function currentGround(): string | null {
    if (!active) return null;
    if (active.kind === "scene") return active.session.spec.ground;
    return groundOverride ?? active.mod.meta.ground ?? null;
  }

  function activePalette(): readonly string[] | null {
    if (!active) return null;
    if (active.kind === "scene") return active.session.spec.palette;
    return active.mod.meta.palette ?? null;
  }

  function updateColorMap() {
    colorMap.clear();
    const palette = activePalette();
    if (!palette) return;
    const overrides = active!.kind === "piece" ? active.colorOverride : undefined;
    for (let i = 0; i < palette.length; i++) {
      const hex = overrides && overrides[i] ? overrides[i] : palette[i];
      colorMap.set(i, hexToRgb(hex));
    }
  }

  // Whether a hex color reads as dark, judged the way mount() judges it.
  function isDark(hex: string): boolean {
    const c = hexToRgb(hex);
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2] < 0.5;
  }

  // One ink for cells the piece left uncolored, honouring the ground.
  function inkFor(ground: string | null): string {
    if (ground) return isDark(ground) ? "#f5f6f7" : "#131518";
    return "#f5f6f7";
  }

  // Canvas sizing: the bitmap matches the piece's cell grid exactly
  // (rows * cell cells tall); CSS maps it into the stage box undistorted.
  function sizeCanvas() {
    const meta = active?.kind === "piece" ? active.mod.meta : active?.session.piece.meta;
    if (!meta) return;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const width = Math.max(320, canvasBox.clientWidth * dpr);
    const nextW = Math.round(width);
    const nextH = Math.round((width * meta.rows * (meta.cell ?? 2)) / meta.cols);
    if (canvas.width !== nextW || canvas.height !== nextH) {
      canvas.width = nextW;
      canvas.height = nextH;
    }
  }

  // Render on-demand (used when paused or after a resize)
  function renderOnDemand() {
    if (active) renderFrame(currentTime);
  }

  const resizeObserver = new ResizeObserver(() => {
    if (!active) return;
    const wasH = canvas.height;
    sizeCanvas();
    if (!isPlaying || canvas.height !== wasH) renderOnDemand();
  });
  resizeObserver.observe(canvasBox);

  // Draw one frame: walk the piece's text the way mount() does, newline
  // resets the column, each glyph drawn on top of the ground fill.
  function renderFrame(t: number) {
    if (!ctx || !active) return;
    const started = performance.now();
    const meta = activeMeta();
    const ground = currentGround();

    const needed = meta.cols * meta.rows;
    if (colorIndices.length !== needed) colorIndices = new Uint8Array(needed);

    const env: Env = { paper: !!ground && !isDark(ground), color: colorIndices };

    let text: string;
    try {
      text = active.kind === "piece" ? active.frame(t, env) : active.session.piece.default()(t, env);
    } catch (err) {
      pausePlayback();
      perfDisplay.textContent = "err";
      codeOutput.textContent = `// ${meta.name}: ${(err as Error).message}`;
      return;
    }
    perfDisplay.textContent = `${(performance.now() - started).toFixed(1)}ms`;

    const cols = meta.cols;
    const rows = meta.rows;
    const cellW = canvas.width / cols;
    const cellH = canvas.height / rows;

    ctx.fillStyle = ground ?? "#070b16";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.font = `${(cellW * 1.15).toFixed(2)}px "ascii.rest mono", ui-monospace, monospace`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    const ink = inkFor(ground);
    let col = 0;
    let row = 0;
    for (let k = 0; k < text.length; k++) {
      const ch = text[k];
      if (ch === "\n") {
        col = 0;
        row++;
        if (row >= rows) break;
        continue;
      }
      if (col >= cols) {
        col = 0;
        row++;
        if (row >= rows) break;
      }
      if (ch !== " ") {
        const color = colorMap.get(colorIndices[row * cols + col]);
        ctx.fillStyle = color
          ? `rgb(${Math.round(color[0] * 255)}, ${Math.round(color[1] * 255)}, ${Math.round(color[2] * 255)})`
          : ink;
        ctx.fillText(ch, (col + 0.5) * cellW, (row + 0.5) * cellH);
      }
      col++;
    }
  }

  // Animation loop with complete pause shutdown (0% CPU when paused)
  function tick(timestamp: number) {
    if (!isPlaying) {
      animId = null;
      return;
    }
    const dt = (timestamp - lastTimestamp) / 1000;
    lastTimestamp = timestamp;
    currentTime = (currentTime + dt * playbackSpeed) % 16.0;
    scrubber.value = currentTime.toFixed(2);
    timeDisplay.textContent = `${currentTime.toFixed(2)}s`;
    renderFrame(currentTime);
    animId = requestAnimationFrame(tick);
  }

  function startPlayback() {
    if (isPlaying && animId !== null) return;
    isPlaying = true;
    playIcon.textContent = "⏸";
    lastTimestamp = performance.now();
    animId = requestAnimationFrame(tick);
  }

  function pausePlayback() {
    isPlaying = false;
    playIcon.textContent = "▶";
    if (animId !== null) {
      cancelAnimationFrame(animId);
      animId = null;
    }
  }

  // --- selection ------------------------------------------------------------

  function setActive(next: Active) {
    active = next;
    groundOverride = null;
    const meta = activeMeta();
    pickerValue.textContent = next.kind === "piece" ? meta.name : next.name;
    selectedLayerId = next.kind === "scene" ? next.session.spec.layers[0]?.id || "" : "";
    updateColorMap();
    sizeCanvas();
    updateLayerUI();
    updatePaletteUI();
    updateCodeView();
    currentTime = 0;
    scrubber.value = "0";
    timeDisplay.textContent = "0.00s";
    renderOnDemand();
  }

  async function selectPiece(slug: string) {
    const token = ++loadToken;
    let mod: Piece;
    try {
      mod = await load[slug]();
    } catch (err) {
      codeOutput.textContent = `// could not load ${slug}: ${(err as Error).message}`;
      return;
    }
    if (token !== loadToken || mod === (active?.kind === "piece" ? active.mod : null)) return;
    setActive({
      kind: "piece",
      slug,
      mod,
      frame: mod.default({ ...(mod.meta.options ?? {}) }),
      options: { ...(mod.meta.options ?? {}) },
      colorOverride: {},
    });
  }

  // Scene-engine specs come from the image ingestion, guarded the same way
  // so a slow file read can't overwrite a newer selection.
  function selectSpec(spec: SceneSpec) {
    setActive({ kind: "scene", session: createStudioSession(spec), name: getSpecTitle(spec) });
  }

  function getSpecTitle(spec: SceneSpec): string {
    return spec.name || "image";
  }

  // --- panels ---------------------------------------------------------------
  // Layer stack + parameters for scene-engine items; the piece's own options
  // for library pieces.

  function updateLayerUI() {
    layerStackWrap.hidden = active === null || active.kind !== "scene";
    paramsTitle.textContent = active?.kind === "scene" ? "parameters" : "options";
    if (active !== null && active.kind === "piece") {
      buildOptionsControls();
      return;
    }
    layerControlsEl.innerHTML = "";
    if (active === null || active.kind !== "scene") return;

    active.session.spec.layers.forEach((layer) => {
      const row = document.createElement("div");
      row.className = `layer-item-row ${layer.id === selectedLayerId ? "selected" : ""}`;

      const left = document.createElement("label");
      left.className = "layer-left";

      const cb = document.createElement("input");
      cb.type = "checkbox";
      cb.className = "layer-chk";
      cb.checked = layer.enabled;
      cb.addEventListener("change", (e) => {
        e.stopPropagation();
        active!.kind === "scene" && active.session.toggleLayer(layer.id, cb.checked);
        renderOnDemand();
        updateCodeView();
      });

      const span = document.createElement("span");
      span.className = "layer-name";
      span.textContent = layer.name;

      left.appendChild(cb);
      left.appendChild(span);
      row.appendChild(left);

      const typeBadge = document.createElement("span");
      typeBadge.className = "layer-type-badge";
      typeBadge.textContent = layer.type;
      row.appendChild(typeBadge);

      row.addEventListener("click", () => {
        if (active?.kind !== "scene") return;
        selectedLayerId = layer.id;
        updateLayerUI();
      });

      layerListEl.appendChild(row);
    });

    renderSelectedLayerControls();
  }

  // Parameters for the selected layer of a scene-engine item (2-line stacked controls)
  function renderSelectedLayerControls() {
    layerControlsEl.innerHTML = "";
    if (active?.kind !== "scene") return;
    const activeLayer = active.session.spec.layers.find((l) => l.id === selectedLayerId);
    if (!activeLayer) return;

    const def = getLayerDefinition(activeLayer.type);
    if (!def) return;

    Object.entries(def.schema).forEach(([key, paramDef]) => {
      if (paramDef.type === "number") {
        const group = document.createElement("div");
        group.className = "param-control-group";

        const header = document.createElement("div");
        header.className = "param-control-header";

        const label = document.createElement("span");
        label.className = "param-label";
        label.textContent = paramDef.label;

        const slider = document.createElement("input");
        slider.type = "range";
        slider.min = String(paramDef.min);
        slider.max = String(paramDef.max);
        slider.step = String(paramDef.step ?? 1);
        slider.value = String(activeLayer.params[key] ?? paramDef.default);

        const valSpan = document.createElement("span");
        valSpan.className = "param-val";
        valSpan.textContent = slider.value;

        slider.addEventListener("input", () => {
          valSpan.textContent = slider.value;
          if (active?.kind === "scene") active.session.setParam(activeLayer.id, key, parseFloat(slider.value));
          renderOnDemand();
          updateCodeView();
        });

        header.appendChild(label);
        header.appendChild(valSpan);
        group.appendChild(header);

        const widget = document.createElement("div");
        widget.className = "param-widget";
        widget.appendChild(slider);
        group.appendChild(widget);

        layerControlsEl.appendChild(group);
      } else if (paramDef.type === "color") {
        const group = document.createElement("div");
        group.className = "param-control-group param-row-between";

        const label = document.createElement("span");
        label.className = "param-label";
        label.textContent = paramDef.label;

        const picker = document.createElement("input");
        picker.type = "color";
        picker.value = activeLayer.params[key] ?? paramDef.default;

        const hexSpan = document.createElement("span");
        hexSpan.className = "param-val";
        hexSpan.textContent = picker.value;

        picker.addEventListener("input", () => {
          hexSpan.textContent = picker.value;
          if (active?.kind === "scene") active.session.setParam(activeLayer.id, key, picker.value);
          renderOnDemand();
          updateCodeView();
        });

        const right = document.createElement("div");
        right.className = "param-color-right";
        right.appendChild(picker);
        right.appendChild(hexSpan);

        group.appendChild(label);
        group.appendChild(right);
        layerControlsEl.appendChild(group);
      } else if (paramDef.type === "select") {
        const group = document.createElement("div");
        group.className = "param-control-group";

        const header = document.createElement("div");
        header.className = "param-control-header";
        const label = document.createElement("span");
        label.className = "param-label";
        label.textContent = paramDef.label;
        header.appendChild(label);
        group.appendChild(header);

        const sel = document.createElement("select");
        paramDef.options.forEach((opt) => {
          const o = document.createElement("option");
          o.value = opt.value;
          o.textContent = opt.label;
          if (opt.value === (activeLayer.params[key] ?? paramDef.default)) {
            o.selected = true;
          }
          sel.appendChild(o);
        });

        sel.addEventListener("change", () => {
          if (active?.kind === "scene") active.session.setParam(activeLayer.id, key, sel.value);
          renderOnDemand();
          updateCodeView();
        });

        const widget = document.createElement("div");
        widget.className = "param-widget";
        widget.appendChild(sel);
        group.appendChild(widget);

        layerControlsEl.appendChild(group);
      } else if (paramDef.type === "boolean") {
        const group = document.createElement("div");
        group.className = "param-control-group param-row-between";

        const label = document.createElement("label");
        label.className = "param-label";
        label.textContent = paramDef.label;
        label.style.cursor = "pointer";

        const cb = document.createElement("input");
        cb.type = "checkbox";
        cb.className = "layer-chk";
        cb.checked = !!(activeLayer.params[key] ?? paramDef.default);
        cb.addEventListener("change", () => {
          if (active?.kind === "scene") active.session.setParam(activeLayer.id, key, cb.checked);
          renderOnDemand();
          updateCodeView();
        });

        group.appendChild(label);
        group.appendChild(cb);
        layerControlsEl.appendChild(group);
      }
    });
  }

  // A control for every entry in a piece's own defaults: numbers as number
  // fields, booleans as checkboxes, text as inputs, string lists as
  // comma-separated values, anything else as JSON.
  function buildOptionsControls() {
    if (active?.kind !== "piece") return;
    const item = active;
    const defaults: Options = item.mod.meta.options ?? {};

    const commit = (value: Options) => {
      try {
        item.frame = item.mod.default(value);
      } catch (err) {
        codeOutput.textContent = `// ${item.mod.meta.name}: ${(err as Error).message}`;
      }
      renderOnDemand();
    };
    const setOption = (key: string, value: unknown) => {
      item.options[key] = value;
      commit({ ...defaults, ...item.options });
    };

    Object.entries(defaults).forEach(([key, def]) => {
      if (typeof def === "number") {
        const group = document.createElement("div");
        group.className = "param-control-group param-row-between";

        const label = document.createElement("label");
        label.className = "param-label";
        label.textContent = key;

        const input = document.createElement("input");
        input.type = "number";
        input.step = "any";
        input.value = typeof item.options[key] === "number" ? String(item.options[key]) : String(def);
        input.addEventListener("change", () => {
          const n = parseFloat(input.value);
          if (Number.isFinite(n)) setOption(key, n);
        });

        group.appendChild(label);
        group.appendChild(input);
        layerControlsEl.appendChild(group);
      } else if (typeof def === "boolean") {
        const group = document.createElement("div");
        group.className = "param-control-group param-row-between";

        const label = document.createElement("label");
        label.className = "param-label";
        label.style.cursor = "pointer";
        label.textContent = key;

        const cb = document.createElement("input");
        cb.type = "checkbox";
        cb.className = "layer-chk";
        cb.checked = item.options[key] ?? def;
        cb.addEventListener("change", () => setOption(key, cb.checked));

        group.appendChild(label);
        group.appendChild(cb);
        layerControlsEl.appendChild(group);
      } else if (typeof def === "string") {
        const group = document.createElement("div");
        group.className = "param-control-group";

        const label = document.createElement("div");
        label.className = "param-label";
        label.textContent = key;

        const input = document.createElement("input");
        input.type = "text";
        input.value = String(item.options[key] ?? def);
        input.spellcheck = false;
        input.addEventListener("change", () => setOption(key, input.value));

        const widget = document.createElement("div");
        widget.className = "param-widget";
        widget.appendChild(input);
        group.appendChild(label);
        group.appendChild(widget);
        layerControlsEl.appendChild(group);
      } else if (Array.isArray(def) && def.length > 0 && def.every((v) => typeof v === "string")) {
        const group = document.createElement("div");
        group.className = "param-control-group";

        const label = document.createElement("div");
        label.className = "param-label";
        label.textContent = key;

        const input = document.createElement("input");
        input.type = "text";
        const current = item.options[key] ?? def;
        input.value = Array.isArray(current) ? (current as string[]).join(", ") : String(current);
        input.placeholder = "comma separated";
        input.spellcheck = false;
        input.addEventListener("change", () => {
          const list = input.value.split(",").map((s) => s.trim()).filter(Boolean);
          setOption(key, list.length ? list : (def as string[]));
        });

        const widget = document.createElement("div");
        widget.className = "param-widget";
        widget.appendChild(input);
        group.appendChild(label);
        group.appendChild(widget);
        layerControlsEl.appendChild(group);
      } else {
        const group = document.createElement("div");
        group.className = "param-control-group";

        const label = document.createElement("div");
        label.className = "param-label";
        label.textContent = key;

        const textarea = document.createElement("textarea");
        textarea.rows = 3;
        textarea.spellcheck = false;
        const current = item.options[key] ?? def;
        textarea.value = JSON.stringify(current, null, 2);
        textarea.addEventListener("change", () => {
          try {
            setOption(key, JSON.parse(textarea.value));
          } catch {
            textarea.value = JSON.stringify(item.options[key] ?? def, null, 2);
          }
        });

        const widget = document.createElement("div");
        widget.className = "param-widget";
        widget.appendChild(textarea);
        group.appendChild(label);
        group.appendChild(widget);
        layerControlsEl.appendChild(group);
      }
    });
  }

  // --- palette tab ------------------------------------------------------------
  // Ground and swatches apply to everything; the halftone rows belong to the
  // scene engine. A swatch click recolors that palette entry.

  function updatePaletteUI() {
    const ground = currentGround();
    const palette = activePalette();

    groundRow.hidden = ground === null;
    if (ground) {
      colGroundInput.value = groundOverride ?? ground;
      hexGroundLabel.textContent = colGroundInput.value;
    }

    halftoneRows.hidden = active?.kind !== "scene";
    paletteNote.hidden = palette !== null;
    paletteSection.hidden = palette === null;
    if (!palette) return;

    paletteCountEl.textContent = String(palette.length);
    paletteGridEl.innerHTML = "";
    palette.forEach((hex, i) => {
      const override = active?.kind === "piece" ? active.colorOverride[i] : undefined;
      const swatch = document.createElement("div");
      swatch.className = "color-swatch clickable";
      swatch.style.backgroundColor = override ?? hex;
      swatch.title = `${override ?? hex} — ${i}`;
      swatch.dataset.index = String(i);
      paletteGridEl.appendChild(swatch);
    });
  }

  function setSwatch(index: number, hex: string) {
    if (active?.kind === "scene") {
      const palette = [...active.session.spec.palette];
      palette[index] = hex;
      active.session.updatePalette(palette, active.session.spec.ground);
      renderOnDemand();
    } else if (active?.kind === "piece") {
      active.colorOverride = { ...active.colorOverride, [index]: hex };
      updateColorMap();
      renderOnDemand();
    }
    updatePaletteUI();
    updateCodeView();
  }

  const swatchPicker = document.createElement("input");
  swatchPicker.type = "color";

  function rgbToHex(css: string): string {
    const m = css.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
    if (!m) return "#000000";
    return `#${[1, 2, 3].map((i) => Number(m[i]).toString(16).padStart(2, "0")).join("")}`;
  }

  paletteGridEl.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(".color-swatch") as HTMLElement | null;
    if (!target || active === null) return;
    const index = Array.from(paletteGridEl.children).indexOf(target);
    if (index < 0) return;
    swatchPicker.value = rgbToHex(getComputedStyle(target).backgroundColor);
    swatchPicker.oninput = () => setSwatch(index, swatchPicker.value);
    swatchPicker.click();
  });

  // --- code view ---------------------------------------------------------------
  // Scene-engine items get the generated standalone piece; library pieces show
  // their own TypeScript, fetched from the site's registry.

  let codeToken = 0;
  const sourceCache = new Map<string, string>();

  async function fetchSource(slug: string): Promise<string> {
    const cached = sourceCache.get(slug);
    if (cached !== undefined) return cached;
    const res = await fetch(`/r/${slug}.json`);
    if (!res.ok) throw new Error(`registry responded ${res.status}`);
    const item = await res.json();
    const source: unknown = item.files?.[0]?.content;
    if (typeof source !== "string") throw new Error("registry item has no source");
    sourceCache.set(slug, source);
    return source;
  }

  const camel = (slug: string) => slug.replace(/-([a-z0-9])/g, (_, c: string) => c.toUpperCase());

  function updateCodeView() {
    if (!active) return;
    const meta = activeMeta();
    if (active.kind === "scene") {
      codeToken++;
      codeLabel.textContent = `standalone TypeScript piece (${meta.cols}x${meta.rows}, ${meta.fps}fps)`;
      codeOutput.textContent = compileSceneToCode(active.session.spec);
      return;
    }
    const item = active;
    const token = ++codeToken;
    codeLabel.textContent = `${meta.name} — source (${meta.cols}x${meta.rows}, ${meta.fps}fps)`;
    codeOutput.textContent = `// loading source of ${meta.name}...`;
    fetchSource(item.slug)
      .then((source) => {
        if (token === codeToken && active === item) codeOutput.textContent = source;
      })
      .catch((err) => {
        if (token !== codeToken || active !== item) return;
        const options = { ...(item.mod.meta.options ?? {}), ...item.options };
        const opts = Object.keys(options).length ? `, ${JSON.stringify(options)}` : "";
        codeOutput.textContent =
          `// registry unavailable (${(err as Error).message}) — run it like this:\n` +
          `import { mount } from "ascii.rest";\n` +
          `import { ${camel(item.slug)} } from "ascii.rest/pieces";\n\n` +
          `mount(document.querySelector("pre")!, ${camel(item.slug)}${opts});`;
      });
  }

  // --- piece picker --------------------------------------------------------------
  // Search first, then groups: choosing a group opens its item menu. The panel
  // opens downward when the screen has room, upward along the top otherwise.

  interface CatalogItem {
    slug: string;
    name: string;
  }
  interface CatalogCategory {
    name: string;
    items: CatalogItem[];
  }
  interface CatalogGroup {
    label: string;
    icon: string;
    categories: CatalogCategory[];
  }

  const catalog: { groups: CatalogGroup[] } = JSON.parse(
    document.getElementById("studio-catalog")!.textContent ?? '{"groups":[]}'
  );
  const everyItem = catalog.groups.flatMap((g) =>
    g.categories.flatMap((c) => c.items.map((i) => ({ ...i, group: g.label, icon: g.icon, category: c.name })))
  );
  const bySlug = new Map(everyItem.map((i) => [i.slug, i]));

  let pickerOpen = false;
  let pickerView: { type: "root" } | { type: "group"; index: number } | { type: "search"; query: string } = { type: "root" };
  let pickerCursor = -1;

  function openPanel() {
    if (pickerOpen) return;
    pickerOpen = true;
    pickerView = { type: "root" };
    pickerSearch.value = "";
    renderMenu();
    pickerPanel.hidden = false;
    pickerBtn.setAttribute("aria-expanded", "true");
    positionPanel();
    pickerSearch.focus();
  }

  function closePanel() {
    if (!pickerOpen) return;
    pickerOpen = false;
    pickerPanel.hidden = true;
    pickerBtn.setAttribute("aria-expanded", "false");
    pickerBtn.focus();
  }

  // Smart placement: measure the panel, then open it below the button when the
  // screen has room, above it when it doesn't, capped to the space either way.
  function positionPanel() {
    pickerPanel.style.visibility = "hidden";
    const needed = pickerPanel.scrollHeight;
    const anchor = pickerBtn.getBoundingClientRect();
    const below = window.innerHeight - anchor.bottom - 16;
    const above = anchor.top - 16;
    const cap = Math.min(needed, 480);
    if (below < Math.min(cap, 220) && above > below) {
      pickerPanel.classList.add("open-up");
      pickerPanel.style.setProperty("--picker-max", `${Math.max(140, Math.min(cap, above))}px`);
    } else {
      pickerPanel.classList.remove("open-up");
      pickerPanel.style.setProperty("--picker-max", `${Math.max(140, Math.min(cap, Math.max(below, 140)))}px`);
    }
    pickerPanel.style.visibility = "";
  }

  pickerBtn.addEventListener("click", () => {
    pickerOpen ? closePanel() : openPanel();
  });

  window.addEventListener("resize", () => {
    if (pickerOpen) positionPanel();
  });

  document.addEventListener("pointerdown", (e) => {
    if (!pickerOpen) return;
    const t = e.target as Node;
    if (pickerPanel.contains(t) || pickerBtn.contains(t)) return;
    closePanel();
  });

  document.addEventListener("keydown", (e) => {
    if (!pickerOpen) return;
    if (e.key === "Escape") {
      e.preventDefault();
      closePanel();
    } else if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      const rows = visibleRows();
      if (!rows.length) return;
      e.preventDefault();
      pickerCursor = e.key === "ArrowDown"
        ? (pickerCursor < 0 ? 0 : (pickerCursor + 1) % rows.length)
        : (pickerCursor < 0 ? rows.length - 1 : (pickerCursor - 1 + rows.length) % rows.length);
      markCursor(rows);
    } else if (e.key === "Enter") {
      const rows = visibleRows();
      const row = pickerCursor >= 0 ? rows[pickerCursor] : rows[0];
      if (row) {
        e.preventDefault();
        (row as HTMLElement).click();
      }
    } else if (e.key === "ArrowLeft" && pickerView.type !== "root" && document.activeElement !== pickerSearch) {
      e.preventDefault();
      pickerView = { type: "root" };
      renderMenu();
    }
  });

  function visibleRows(): Element[] {
    return Array.from(pickerMenu.querySelectorAll<HTMLElement>(".picker-row:not([hidden])"));
  }

  function markCursor(rows: Element[]) {
    rows.forEach((r, i) => r.classList.toggle("picker-active", i === pickerCursor));
    rows[pickerCursor]?.scrollIntoView({ block: "nearest" });
  }

  function renderMenu() {
    pickerCursor = -1;
    pickerMenu.innerHTML = "";

    if (pickerView.type === "root") {
      catalog.groups.forEach((group, index) => {
        const count = group.categories.reduce((sum, c) => sum + c.items.length, 0);
        const row = document.createElement("button");
        row.type = "button";
        row.className = "picker-row picker-group";
        row.setAttribute("role", "menuitem");
        row.innerHTML = `<span class="picker-icon">${group.icon}</span><span class="picker-label">${group.label}</span><span class="picker-count">${count}</span>`;
        row.addEventListener("click", () => {
          pickerView = { type: "group", index };
          renderMenu();
        });
        pickerMenu.appendChild(row);
      });
      return;
    }

    if (pickerView.type === "group") {
      const group = catalog.groups[pickerView.index];
      const back = document.createElement("button");
      back.type = "button";
      back.className = "picker-row picker-back";
      back.innerHTML = `<span>‹</span><span>all groups</span>`;
      back.addEventListener("click", () => {
        pickerView = { type: "root" };
        renderMenu();
      });
      pickerMenu.appendChild(back);

      const title = document.createElement("div");
      title.className = "picker-title";
      title.innerHTML = `<span class="picker-icon">${group.icon}</span><span>${group.label}</span>`;
      pickerMenu.appendChild(title);

      group.categories.forEach((category) => {
        const head = document.createElement("div");
        head.className = "picker-cat";
        head.innerHTML = `<span>${category.name}</span><span class="picker-count">${category.items.length}</span>`;
        pickerMenu.appendChild(head);
        category.items.forEach((item) => pickerMenu.appendChild(itemRow(item)));
      });
      return;
    }

    // search: flat matches across every group, in the order they appear
    const words = pickerView.query.toLowerCase().split(/\s+/).filter(Boolean);
    const hits = words.length
      ? everyItem.filter((i) => words.every((w) => `${i.name} ${i.slug} ${i.category}`.includes(w)))
      : [];
    if (!hits.length) {
      const empty = document.createElement("div");
      empty.className = "picker-empty";
      empty.textContent = `nothing matches "${pickerView.query}"`;
      pickerMenu.appendChild(empty);
      return;
    }
    let lastGroup = "";
    hits.forEach((item) => {
      if (item.group !== lastGroup) {
        lastGroup = item.group;
        const head = document.createElement("div");
        head.className = "picker-cat";
        head.innerHTML = `<span class="picker-icon">${item.icon}</span><span>${item.group}</span>`;
        pickerMenu.appendChild(head);
      }
      pickerMenu.appendChild(itemRow(item));
    });
  }

  function itemRow(item: { slug: string; name: string }): HTMLButtonElement {
    const row = document.createElement("button");
    row.type = "button";
    row.className = "picker-row picker-item";
    row.setAttribute("role", "menuitem");
    row.dataset.slug = item.slug;
    row.innerHTML = `<span class="picker-name">${item.name}</span><span class="picker-count">${item.slug}</span>`;
    row.addEventListener("click", () => {
      closePanel();
      const current = active?.kind === "piece" ? active.slug : null;
      if (current !== item.slug) selectPiece(item.slug);
    });
    return row;
  }

  pickerSearch.addEventListener("input", () => {
    const query = pickerSearch.value.trim();
    pickerView = query ? { type: "search", query } : { type: "root" };
    renderMenu();
  });

  // --- transport ---------------------------------------------------------------

  playBtn.addEventListener("click", () => {
    if (isPlaying) pausePlayback();
    else startPlayback();
  });

  scrubber.addEventListener("input", () => {
    currentTime = parseFloat(scrubber.value);
    timeDisplay.textContent = `${currentTime.toFixed(2)}s`;
    renderOnDemand();
  });

  speedPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      speedPills.forEach((p) => p.classList.remove("active"));
      pill.classList.add("active");
      playbackSpeed = parseFloat(pill.getAttribute("data-speed") || "1.0");
    });
  });

  // Tab switching
  panelTabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      panelTabs.forEach((b) => b.classList.remove("active"));
      panelBodies.forEach((p) => p.classList.remove("active"));

      btn.classList.add("active");
      const tabId = btn.getAttribute("data-tab");
      if (tabId) {
        document.getElementById(tabId)?.classList.add("active");
      }
    });
  });

  // Palette & halftone form listeners (scene engine only)
  colGroundInput.addEventListener("input", () => {
    if (active?.kind === "scene") {
      hexGroundLabel.textContent = colGroundInput.value;
      active.session.updatePalette(active.session.spec.palette, colGroundInput.value);
      renderOnDemand();
      updateCodeView();
    } else if (active?.kind === "piece") {
      groundOverride = colGroundInput.value;
      hexGroundLabel.textContent = colGroundInput.value;
      renderOnDemand();
    }
  });

  selRamp.addEventListener("change", () => {
    if (active?.kind !== "scene") return;
    const spec = active.session.spec;
    spec.halftone = spec.halftone || {};
    spec.halftone.ramp = selRamp.value;
    renderOnDemand();
    updateCodeView();
  });

  selDither.addEventListener("change", () => {
    if (active?.kind !== "scene") return;
    const spec = active.session.spec;
    spec.halftone = spec.halftone || {};
    spec.halftone.dither = selDither.value as "bayer4" | "bayer8" | "none";
    renderOnDemand();
    updateCodeView();
  });

  rangeContrast.addEventListener("input", () => {
    if (active?.kind !== "scene") return;
    valContrast.textContent = rangeContrast.value;
    const spec = active.session.spec;
    spec.halftone = spec.halftone || {};
    spec.halftone.contrast = parseFloat(rangeContrast.value);
    renderOnDemand();
    updateCodeView();
  });

  // Code copy buttons
  function copyCode() {
    const code = codeOutput.textContent ?? "";
    navigator.clipboard.writeText(code).then(() => {
      const origText = btnExportCode.textContent;
      btnExportCode.textContent = "[copied!]";
      btnCopyCodeTab.textContent = "[copied!]";
      setTimeout(() => {
        btnExportCode.textContent = origText;
        btnCopyCodeTab.textContent = "[copy code]";
      }, 1500);
    });
  }

  btnExportCode.addEventListener("click", copyCode);
  btnCopyCodeTab.addEventListener("click", copyCode);

  // Image drop & ingestion: a photo becomes a one-layer scene spec
  const COLS = 200;
  const ROWS = 100;

  imageDrop.addEventListener("click", () => imageFileInput.click());
  imageDrop.addEventListener("dragover", (e) => e.preventDefault());
  imageDrop.addEventListener("drop", (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) {
      handleImageUpload(e.dataTransfer.files[0]);
    }
  });

  imageFileInput.addEventListener("change", () => {
    if (imageFileInput.files?.length) {
      handleImageUpload(imageFileInput.files[0]);
    }
  });

  function handleImageUpload(file: File) {
    const img = new Image();
    img.src = URL.createObjectURL(file);
    img.onload = () => {
      const offCanvas = document.createElement("canvas");
      offCanvas.width = COLS;
      offCanvas.height = ROWS;
      const offCtx = offCanvas.getContext("2d");
      if (!offCtx) return;

      offCtx.drawImage(img, 0, 0, COLS, ROWS);
      const imgData = offCtx.getImageData(0, 0, COLS, ROWS);

      const pixels = new Float32Array(COLS * ROWS * 3);
      const colorCounts = new Map<string, number>();

      for (let i = 0; i < COLS * ROWS; i++) {
        const r = imgData.data[i * 4] / 255;
        const g = imgData.data[i * 4 + 1] / 255;
        const b = imgData.data[i * 4 + 2] / 255;
        pixels[i * 3] = r;
        pixels[i * 3 + 1] = g;
        pixels[i * 3 + 2] = b;

        const qr = Math.floor(r * 5) * 51;
        const qg = Math.floor(g * 5) * 51;
        const qb = Math.floor(b * 5) * 51;
        const hex = `#${((1 << 24) + (qr << 16) + (qg << 8) + qb).toString(16).slice(1)}`;
        colorCounts.set(hex, (colorCounts.get(hex) || 0) + 1);
      }

      const sorted = Array.from(colorCounts.entries()).sort((a, b) => b[1] - a[1]);
      const palette = sorted.slice(0, 32).map((e) => e[0]);

      const imageSpec: SceneSpec = {
        name: file.name.replace(/\.[^/.]+$/, "").toLowerCase(),
        ground: palette[0] || "#000000",
        palette: palette.length ? palette : ["#000000", "#ffffff"],
        fps: 15,
        layers: [
          {
            id: "img-layer-1",
            type: "image",
            name: "Photo Plane",
            enabled: true,
            params: {
              horizon: parseInt(ingestSplit.value),
              motionType: ingestMotion.value,
              motionSpeed: 1.0,
              motionIntensity: 0.08,
            },
          },
        ],
      };

      selectSpec(imageSpec);
    };
  }

  // Initialize on the library's own ocean sunset
  (async () => {
    try {
      await selectPiece("ocean-sunset");
    } catch (err) {
      codeOutput.textContent = `// could not load the first piece: ${(err as Error).message}`;
    }
    startPlayback();
  })();
</script>
