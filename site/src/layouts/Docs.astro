---
/*
 * A docs page: the site's shell with the docs' index in the sidebar instead of
 * the pieces, the page's own headings above it, its Markdown, and the pages
 * before and after it. Code blocks get a [copy] button, and the tags from
 * ascii.rest/element are defined, so a page can show <ascii-banner> live. A
 * component an ```ascii fence drew plays as it is scrolled to.
 */
import type { MarkdownLayoutProps } from "astro";
import Layout from "./Layout.astro";
import { DOCS, pages } from "../lib/docs";
import { REPO } from "../lib/library";

type Props = MarkdownLayoutProps<{ title: string; description: string }>;

const { frontmatter, url = "/docs/", headings = [] } = Astro.props;
const path = url.endsWith("/") ? url : `${url}/`;
const at = pages.findIndex((p) => p.href === path);
const prev = pages[at - 1];
const next = pages[at + 1];
const file = path === "/docs/" ? "index" : path.slice("/docs/".length, -1);
const sections = headings.filter((h) => h.depth === 2);
---

<Layout
  title={`${frontmatter.title} · ascii.rest docs`}
  description={frontmatter.description}
  path={path}
  card={{ path: `/og/docs/${file}.png`, alt: `${frontmatter.title}, ascii.rest docs: ${frontmatter.description}` }}
>
  <h1 slot="heading">{frontmatter.title}</h1>

  <nav slot="side" class="docs-nav" aria-label="Docs">
    {DOCS.map((section) => (
      <>
        <h2>{section.label}</h2>
        <ul role="list">
          {section.pages.map((p) => (
            <li>
              <a href={p.href} aria-current={p.href === path ? "page" : undefined}>{p.title}</a>
            </li>
          ))}
        </ul>
      </>
    ))}
    <h2>more</h2>
    <ul role="list">
      <li><a href="/#pieces">every piece</a></li>
      <li><a href="/banner/">banner maker</a></li>
      <li><a href="https://www.npmjs.com/package/ascii.rest">npm</a></li>
      <li><a href={REPO}>github</a></li>
    </ul>
  </nav>

  <p class="lede">{frontmatter.description}</p>

  {sections.length > 1 && (
    <nav class="toc muted" aria-label="On this page">
      <span>on this page</span>
      {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
  )}

  <article class="docs">
    <slot />
  </article>

  <nav class="pager" aria-label="Docs pages">
    {prev ? <a href={prev.href}>&lt; {prev.title}</a> : <span></span>}
    {next ? <a href={next.href}>{next.title} &gt;</a> : <span></span>}
  </nav>
  <p class="edit muted"><a href={`${REPO}/blob/main/site/src/pages/docs/${file}.md`}>[edit this page on github]</a></p>
</Layout>

<script>
  import "ascii.rest/element";

  // Each code block gets a [copy] button, as the rest of the site's code does. A component's copies its still, the
  // finished drawing as plain() prints it for a README, spaces at line ends left out: the page holds it until start()
  // below plays it, so it is taken now, never the frame the component is on when the button is clicked.
  document.querySelectorAll<HTMLPreElement>(".docs pre").forEach((pre) => {
    const still = pre.matches("[data-md]") ? (pre.textContent ?? "").split("\n").map((l) => l.trimEnd()).join("\n") : null;
    const button = document.createElement("button");
    button.className = "button copy";
    button.type = "button";
    button.innerHTML = "<span>[copy]</span>";
    const label = button.firstElementChild as HTMLElement;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(still ?? pre.textContent ?? "");
        label.textContent = "[copied]";
      } catch {
        label.textContent = "[select and copy]";
      }
      setTimeout(() => (label.textContent = "[copy]"), 1600);
    });
    const wrap = document.createElement("div");
    wrap.className = "snippet";
    pre.replaceWith(wrap);
    wrap.append(pre, button);
  });

  // The markdown components the remark plugin drew, in the site's own colours, each built in as it is scrolled to.
  // They hold still, as the pieces do, when the system asks for reduced motion, unless the reader chose to play them
  // anyway; the header's [play anyway] and [hold still] say "ascii-motion", and they start again that way.
  const docs = document.querySelector<HTMLElement>(".docs");
  if (docs?.querySelector("pre[data-md]")) {
    let motion = false;
    try {
      motion = localStorage.getItem("ascii-motion") === "play";
    } catch {}
    import("ascii.rest/markdown").then(
      ({ start }) => {
        let stop = start(docs, { style: false, motion });
        addEventListener("ascii-motion", (e) => {
          stop();
          stop = start(docs, { style: false, motion: (e as CustomEvent<boolean>).detail });
        });
      },
      () => (window as Window & { asciiReload?: () => void }).asciiReload?.(),
    );
  }
</script>
