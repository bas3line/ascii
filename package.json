{
  "name": "ascii.rest",
  "version": "0.4.0",
  "description": "Animated ascii art for web pages, READMEs and terminals, in TypeScript: React, Next.js, Astro, one HTML tag, SVG, or copied into your project, and a kit for making your own.",
  "license": "MIT",
  "author": "bas3line (https://github.com/bas3line)",
  "homepage": "https://ascii.rest/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bas3line/ascii.git"
  },
  "keywords": ["ascii", "ascii-art", "animation", "react", "nextjs", "astro", "web-component", "astro-component", "terminal", "cli", "banner", "svg", "readme", "github-readme", "shadcn", "generative-art", "creative-coding"],
  "type": "module",
  "bin": {
    "ascii.rest": "dist/cli.js"
  },
  "sideEffects": ["./dist/ascii.js", "./dist/markdown/element.js", "./src/astro/*.astro"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pieces": {
      "types": "./dist/pieces/index.d.ts",
      "default": "./dist/pieces/index.js"
    },
    "./pieces/*": {
      "types": "./dist/pieces/*.d.ts",
      "default": "./dist/pieces/*.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/ascii.d.ts",
      "default": "./dist/ascii.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "default": "./dist/terminal.js"
    },
    "./banner": {
      "types": "./dist/banner.d.ts",
      "default": "./dist/banner.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./kit/recipes": {
      "types": "./dist/kit/recipes/index.d.ts",
      "default": "./dist/kit/recipes/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./markdown/remark": {
      "types": "./dist/markdown/remark.d.ts",
      "default": "./dist/markdown/remark.js"
    },
    "./markdown/react": {
      "types": "./dist/markdown/react.d.ts",
      "default": "./dist/markdown/react.js"
    },
    "./markdown/element": {
      "types": "./dist/markdown/element.d.ts",
      "default": "./dist/markdown/element.js"
    },
    "./astro": "./src/astro/Ascii.astro",
    "./astro/banner": "./src/astro/Banner.astro"
  },
  "files": ["dist", "src/astro"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/check.ts",
    "test": "node --test \"src/kit/*.test.ts\" \"src/kit/recipes/*.test.ts\" \"src/markdown/*.test.ts\"",
    "test:perf": "KIT_PERF=1 node --test --test-concurrency=1 \"src/kit/*.test.ts\" \"src/kit/recipes/*.test.ts\"",
    "kit": "node scripts/kit/show.ts",
    "kit:docs": "node scripts/kit/docs.ts",
    "kit:examples": "node scripts/kit/examples.ts",
    "markdown:examples": "node scripts/kit/examples.ts --dir examples/markdown",
    "gen": "node scripts/gen.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
