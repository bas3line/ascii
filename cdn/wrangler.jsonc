{
  // cdn.ascii.rest: the docs' videos and files, from the R2 bucket ascii-rest-cdn, through worker.ts.
  // It is its own Worker, beside the site's: npx wrangler deploy from this folder.
  "$schema": "../site/node_modules/wrangler/config-schema.json",
  "name": "ascii-rest-cdn",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "cdn.ascii.rest", "custom_domain": true }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ascii-rest-cdn" }]
}
